.TH "REPO" "1" "" "repo 2.0.0" "Repo"
.SH NAME
repo \- A fictional repository tool with commands nested four levels deep
.SH SYNOPSIS
.B repo
[options] <command>
.SH OPTIONS
.TP
\fB\-\-verbose\fR, \fB\-v\fR
Print more
.TP
\fB\-\-config\fR \fI<file>\fR
Configuration file
.TP
\fB\-\-color\fR
Only for the root command
.SH COMMANDS
.SS "repo remote"
.B repo remote
[options] <command>
.PP
Manage remotes
.PP
Aliases: r.
.PP
\fBOptions:\fR
.TP
\fB\-\-dry\-run\fR
Show what would change
.SS "repo remote add"
.B repo remote add
[options] <name> <url>
.PP
Add a remote
.PP
\fBOptions:\fR
.TP
\fB\-\-fetch\fR
Fetch after adding
.PP
\fBArguments:\fR
.TP
\fIname\fR
Required.
.TP
\fIurl\fR
Required.
.SS "repo remote list"
.B repo remote list
[options] [<pattern>]
.PP
List remotes
.PP
Aliases: ls.
.PP
\fBArguments:\fR
.TP
\fIpattern\fR
.SS "repo remote set-url"
.B repo remote set-url
[options] <name> <url>
.PP
Change the URL of a remote
.PP
\fBArguments:\fR
.TP
\fIname\fR
Required.
.TP
\fIurl\fR
Required.
.SS "repo remote branch"
.B repo remote branch
[options] <command>
.PP
Manage the branches of a remote
.PP
\fBOptions:\fR
.TP
\fB\-\-dry\-run\fR
Show what would change
.SS "repo remote branch list"
.B repo remote branch list
[options] <remote>
.PP
List the branches of a remote
.PP
\fBArguments:\fR
.TP
\fIremote\fR
Required.
.SS "repo branch"
.B repo branch
[options] <command>
.PP
Manage local branches
.SS "repo branch list"
.B repo branch list
[options]
.PP
List local branches
.SS "repo branch create"
.B repo branch create
[options] <name>
.PP
Create a branch
.PP
\fBArguments:\fR
.TP
\fIname\fR
Required.
.SS "repo branch delete"
.B repo branch delete
[options] <name>...
.PP
Delete branches
.PP
Aliases: rm.
.PP
\fBOptions:\fR
.TP
\fB\-\-force\fR, \fB\-f\fR
Delete even if unmerged
.PP
\fBArguments:\fR
.TP
\fIname\fR...
Required.
.SS "repo config"
.B repo config
[options] [<command>] [<key>] [<value>]
.PP
Read or write configuration
.PP
With no key, prints the whole configuration.
.PP
\fBArguments:\fR
.TP
\fIkey\fR
.TP
\fIvalue\fR
.SS "repo config edit"
.B repo config edit
[options]
.PP
Open the configuration in an editor
.PP
This command prompts for input.
.SS "repo sync"
.B repo sync
[options]
.PP
Synchronise with all remotes
.PP
\fBOptions:\fR
.TP
\fB\-\-dry\-run\fR
Show what would change
