        {
          "level": 2,
          "heading": "`kitchen cook`",
          "blocks": [
            {
              "kind": "paragraph",
              "text": "Cook a dish"
            },
            {
              "kind": "paragraph",
              "text": "Cooks the given dish with the given options."
            },
            {
              "kind": "paragraph",
              "text": "Aliases: `c`\nCategory: Meals"
            },
            {
              "kind": "code",
              "text": "kitchen cook [options] \u003cdish\u003e [\u003cservings\u003e]"
            }
          ],
          "sections": [
            {
              "level": 3,
              "heading": "Options",
              "blocks": [
                {
                  "kind": "table",
                  "header": [
                    "Option",
                    "Value",
                    "Description"
                  ],
                  "rows": [
                    [
                      "`--heat`",
                      "`\u003clevel\u003e` int; 1..9; default: 5",
                      "Heat level"
                    ],
                    [
                      "`--timer`",
                      "`\u003cduration\u003e` duration; default: 1m30s",
                      ""
                    ],
                    [
                      "`--style`",
                      "`\u003cstyle\u003e` one of: plain, fancy; default: plain",
                      "Group: Presentation."
                    ],
                    [
                      "`--weights`, `-w`",
                      "`\u003ckg\u003e...` float; \u003e= 0; default: 0.5, 2",
                      ""
                    ],
                    [
                      "`--salt`",
                      "`\u003cbool\u003e` boolean; default: true",
                      ""
                    ],
                    [
                      "`--batch`",
                      "`\u003cid\u003e` uint",
                      "Required."
                    ]
                  ]
                }
              ]
            },
